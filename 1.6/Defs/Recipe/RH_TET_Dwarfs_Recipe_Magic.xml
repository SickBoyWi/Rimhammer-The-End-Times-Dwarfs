	<RecipeDef ParentName="RH_TET_Dwarfs_MakeStoneWoolBase">
		<defName>RH_TET_Dwarfs_Make_StoneWoolSandstone</defName>
		<label>make sandstone weave</label>
		<description>Use runic magic to craft sandstone chunks into sandstone thread.</description>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ChunkSandstone</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>ChunkSandstone</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<RH_TET_Dwarfs_WoolSandstone>25</RH_TET_Dwarfs_WoolSandstone>
		</products>
	</RecipeDef>
