	<RecipeDef ParentName="RH_TET_Dwarfs_RuneRecipeBase">
		<defName>RH_TET_Dwarfs_Rune_Blank</defName>
		<label>Forge rune blank</label>
		<description>Forge a rune blank at the runic anvil to be used later for crafting a proper rune of power.</description>
		<jobString>Forging rune blank.</jobString>
		<workAmount>10000</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Silver</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>RH_TET_Dwarf_Gromril</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Silver</li>
				<li>RH_TET_Dwarf_Gromril</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<RH_TET_Dwarfs_Rune_Blank>1</RH_TET_Dwarfs_Rune_Blank>
		</products>
		<skillRequirements>
			<Crafting>10</Crafting>
		</skillRequirements>
		<researchPrerequisites>
			<li>RH_TET_Dwarfs_Runic_Basic</li>
		</researchPrerequisites>
		<recipeUsers>
			<li>RH_TET_TableSmithy</li>
			<li>RH_TET_Dwarfs_TableAnvil</li>
			<li>RH_TET_Dwarfs_TableRunicAnvil</li>
		</recipeUsers>
	</RecipeDef>
	
