<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<RecipeDef>
		<defName>RH_TET_Dwarfs_Magic_RefineMagic</defName>
		<label>refine magic essence</label>
		<description>Turn raw magic essence into refined magic essence so that it's usable for crafting, at a runic anvil.</description>
		<jobString>Refining magic essence.</jobString>
		<workAmount>1000</workAmount>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<workSkill>Crafting</workSkill>
		<effectWorking>Smelt</effectWorking>
		<soundWorking>Recipe_Cremate</soundWorking>
		<unfinishedThingDef>RH_TET_Unfinished_MagicItem</unfinishedThingDef>
		<allowMixingIngredients>false</allowMixingIngredients>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>RH_TET_Daemons_MagicEssence_Raw</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>RH_TET_Daemons_MagicEssence_Raw</li>
				<li>Steel</li>
			</thingDefs>
		</fixedIngredientFilter>
		<recipeUsers>
			<li>RH_TET_Dwarfs_TableRunicAnvil</li>
		</recipeUsers>
		<products>
			<RH_TET_Daemons_MagicEssence_Refined>10</RH_TET_Daemons_MagicEssence_Refined>
		</products>
		<skillRequirements>
			<Crafting>6</Crafting>
		</skillRequirements>
		<researchPrerequisites>
			<li>RH_TET_Dwarfs_Runic_Basic</li>
		</researchPrerequisites>
	</RecipeDef>

