			<texPath>Things/Building/Production/RH_TET_Dwarfs_PillarSculptingSpot</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3.2,1.2)</drawSize>
		</graphicData>
		<fillPercent>0.2</fillPercent>
		<altitudeLayer>Building</altitudeLayer>
		<statBases>
			<WorkToBuild>1500</WorkToBuild>
			<Flammability>.5</Flammability>
			<Cleanliness>-5</Cleanliness>
		</statBases>
		<stuffCategories>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>65</costStuffCount>
		<costList>
			<Steel>25</Steel>
			<WoodLog>10</WoodLog>
		</costList>
		<scatterableOnMapGen>false</scatterableOnMapGen>
		<useHitPoints>true</useHitPoints>
		<uiIconScale>1</uiIconScale>
		<size>(3,1)</size>
		<designationCategory>Production</designationCategory>
		<passability>Standable</passability>
		<hasInteractionCell>True</hasInteractionCell>
		<pathCost>25</pathCost>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<building>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
			<canPlaceOverImpassablePlant>false</canPlaceOverImpassablePlant>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<comps>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>ToolCabinet</li>
				</linkableFacilities>
			</li>
		</comps>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<designationHotKey>Misc2</designationHotKey>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_ReportWorkSpeedPenalties</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>RH_TET_Dwarf_StructureArt</li>
			<li>RH_TET_Dwarfs_Furniture_Basic</li>
		</researchPrerequisites>
	</ThingDef>
  
	<ThingDef ParentName="RH_TET_Dwarfs_BenchBase">
		<defName>RH_TET_Dwarfs_TableForge</defName>
		<label>dawi forge</label>
		<description>A forge for heating metals, as well as destroying unwanted weapons and apparel.</description>
		<thingClass>Building_WorkTable</thingClass>
		<size>(2,2)</size>
		<graphicData>
			<texPath>Things/Building/Production/RH_TET_Dwarf_Forge</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3,3)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<filthLeaving>Filth_RubbleBuilding</filthLeaving>
		<costList>
			<WoodLog>10</WoodLog>
		</costList>
		<costStuffCount>100</costStuffCount>
		<stuffCategories>
			<li>Stony</li>
		</stuffCategories>
		<altitudeLayer>Building</altitudeLayer>
		<fillPercent>0.5</fillPercent>
		<useHitPoints>True</useHitPoints>
		<statBases>
			<Mass>200</Mass>
			<WorkToBuild>2000</WorkToBuild>
			<MaxHitPoints>150</MaxHitPoints>
			<Flammability>0</Flammability>
			<Cleanliness>-2</Cleanliness>
			<WorkTableWorkSpeedFactor>1.0</WorkTableWorkSpeedFactor>
		</statBases>
		<designationCategory>Production</designationCategory>
		<passability>PassThroughOnly</passability>
		<pathCost>70</pathCost>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<recipes>
			<li>RH_TET_ExtractMetalFromSlag</li>
			<li>RH_TET_SmeltWeapon</li>
			<li>RH_TET_SmeltApparel</li>
			<li>RH_TET_DestroyWeapon</li>
			<li>RH_TET_DestroyApparel</li>
		</recipes>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<building>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
			<heatPerTickWhileWorking>0.32</heatPerTickWhileWorking>
		</building>
		<comps>
			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>80.0</fuelConsumptionRate>
				<fuelCapacity>50.0</fuelCapacity>
				<fuelFilter>
					<thingDefs>
						<li>WoodLog</li>
						<li>RH_TET_Coal</li>
					</thingDefs>
				</fuelFilter>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>			
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
				<canEjectFuel>true</canEjectFuel>	
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>6</glowRadius>
				<glowColor>(237,131,43,0)</glowColor>
			</li>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>ToolCabinet</li>
				</linkableFacilities>
			</li>
			<li Class="CompProperties_Facility">
				<statOffsets>
					<WorkTableWorkSpeedFactor>0.15</WorkTableWorkSpeedFactor>
				</statOffsets>
				<maxSimultaneous>1</maxSimultaneous>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_ReportWorkSpeedPenalties</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>Smithing</li>
			<li>RH_TET_Dwarfs_Furniture_Basic</li>
		</researchPrerequisites>
		<designationHotKey>Misc7</designationHotKey>
		<castEdgeShadows>false</castEdgeShadows>
		<staticSunShadowHeight>0</staticSunShadowHeight>
	</ThingDef>
  
