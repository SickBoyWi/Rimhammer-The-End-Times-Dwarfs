	<ThingDef ParentName="ResourceBase" Name="RH_TET_Dwarfs_StoneWoolBase" Abstract="True">
		<stackLimit>100</stackLimit>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<MarketValue>4.0</MarketValue>
			<Mass>0.038</Mass>
			<Flammability>0.0</Flammability>
