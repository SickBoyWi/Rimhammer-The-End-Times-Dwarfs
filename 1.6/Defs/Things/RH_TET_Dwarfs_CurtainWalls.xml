		<uiIconPath>UI/Menu/CurtainWallEndOuterUI</uiIconPath>
	</ThingDef>

	<ThingDef ParentName="RH_TET_Dwarfs_CastleWallBase">
		<defName>RH_TET_Dwarfs_CastleWallShortMassive</defName>
		<label>Dwarf Massive Wall Short</label>
		<description>A huge crennelated wall, intended to surround the settlement or quarters that are built up immediately outside of a dwarfen hold. Built to keep enemy armies outside. Made of stone. Very strong. Typically the first major gate in any assault on a dwarfen hold from the outside.\n\nThis is a short piece, for when you have to connect other larger wall pieces with limited space.</description>
		<altitudeLayer>Building</altitudeLayer>
		<blockWind>true</blockWind>
		<fillPercent>1</fillPercent>
		<costStuffCount>15</costStuffCount>
		<statBases>
			<Mass>2000</Mass>
