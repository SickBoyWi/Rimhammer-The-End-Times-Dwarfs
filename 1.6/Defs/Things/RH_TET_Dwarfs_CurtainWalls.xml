			<WorkToBuild>1800</WorkToBuild>
			<Beauty>8</Beauty>
		</statBases>
		<rotatable>true</rotatable>
		<graphicData>
			<texPath>Things/Building/Structure/Bottom_Half_WallShort</texPath>
		</graphicData>
		<size>(1,5)</size>
		<uiIconPath>UI/Menu/CurtainWallShortUI</uiIconPath>
	</ThingDef>
  
