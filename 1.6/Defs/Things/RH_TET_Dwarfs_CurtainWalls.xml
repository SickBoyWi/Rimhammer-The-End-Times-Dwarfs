<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Massive Walls -->
	<ThingDef Name="RH_TET_Dwarfs_CastleWallBase" ParentName="BuildingBase" Abstract="True">
		<designationCategory>Structure</designationCategory>
		<passability>Impassable</passability>
		<pathCost>0</pathCost>
		<stuffCategories>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>100</costStuffCount>
		<fertility>0</fertility>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>RH_TET_Dwarf_WallsHighBlood</li>
		</researchPrerequisites>
		<building>
			<isInert>true</isInert>
			<ai_chillDestination>false</ai_chillDestination>
			<supportsWallAttachments>true</supportsWallAttachments>
		</building>
		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(8,8)</drawSize>
			<drawOffset>(0,0,1.0)</drawOffset>
			<drawRotated>true</drawRotated>
			<shadowData>
				<volume>(0.3, 0.5, 0.3)</volume>
				<offset>(0,0,-0.23)</offset>
			</shadowData>
			<damageData>
				<rectN>(0.1,0.3,2.8,2.0)</rectN>
				<rectS>(0.1,0.3,2.8,2.0)</rectS>
				<rectE>(0.5,0.0,2.0,2.0)</rectE>
				<rectW>(0.5,0.0,2.0,2.0)</rectW>
			</damageData>
		</graphicData>
		<canOverlapZones>false</canOverlapZones>
		<size>(5,5)</size>
		<defaultPlacingRot>South</defaultPlacingRot>
	</ThingDef>
 
	<ThingDef ParentName="RH_TET_Dwarfs_CastleWallBase">
		<defName>RH_TET_Dwarfs_CastleWallMassive</defName>
		<label>Dwarf Massive Wall</label>
		<description>A huge crennelated wall, intended to surround the settlement or quarters that are built up immediately outside of a dwarfen hold. Built to keep enemy armies outside. Made of stone. Very strong. Typically the first major gate in any assault on a dwarfen hold from the outside.\n\nThis is the standard wall piece.</description>
		<altitudeLayer>Building</altitudeLayer>
		<blockWind>true</blockWind>
		<fillPercent>1</fillPercent>
		<statBases>
			<Mass>2000</Mass>
			<MaxHitPoints>4000</MaxHitPoints>
			<WorkToBuild>1800</WorkToBuild>
			<Beauty>8</Beauty>
		</statBases>
		<rotatable>true</rotatable>
		<graphicData>
			<texPath>Things/Building/Structure/Bottom_Half_Wall</texPath>
		</graphicData>
		<uiIconPath>UI/Menu/CurtainWallUI</uiIconPath>
	</ThingDef>

	<ThingDef ParentName="RH_TET_Dwarfs_CastleWallBase">
		<defName>RH_TET_Dwarfs_CastleWallEndMassive</defName>
		<label>Dwarf Massive Wall End</label>
		<description>A huge crennelated wall, intended to surround the settlement or quarters that are built up immediately outside of a dwarfen hold. Built to keep enemy armies outside. Made of stone. Very strong. Typically the first major gate in any assault on a dwarfen hold from the outside.\n\nThis is an end piece, for when you have to end a wall that won't connect to a different wall piece on one end.</description>
		<altitudeLayer>Building</altitudeLayer>
		<blockWind>true</blockWind>
		<fillPercent>1</fillPercent>
		<statBases>
			<Mass>2000</Mass>
			<MaxHitPoints>4000</MaxHitPoints>
			<WorkToBuild>1800</WorkToBuild>
			<Beauty>8</Beauty>
		</statBases>
		<rotatable>true</rotatable>
		<graphicData>
			<texPath>Things/Building/Structure/Bottom_Half_WallEnd</texPath>
		</graphicData>
		<uiIconPath>UI/Menu/CurtainWallEndUI</uiIconPath>
	</ThingDef>

	<ThingDef ParentName="RH_TET_Dwarfs_CastleWallBase">
