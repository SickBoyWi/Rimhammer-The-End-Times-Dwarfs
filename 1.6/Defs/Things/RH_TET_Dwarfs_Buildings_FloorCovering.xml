<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef Name="RH_TET_Dwarfs_RugBase" Abstract="True">
		<designationCategory>Furniture</designationCategory>
		<thingClass>Building</thingClass>
		<building>
			<isEdifice>false</isEdifice>
		</building>
		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
		</graphicData>
		<statBases>
			<Flammability>0.0</Flammability>
			<Cleanliness>0.5</Cleanliness>
		</statBases>
		<category>Building</category>
		<thingCategories>
			<li>RH_TET_Dwarfs_BuildingsFurniture</li>
		</thingCategories>
		<clearBuildingArea>false</clearBuildingArea>
		<soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
		<selectable>true</selectable>
		<drawerType>MapMeshAndRealTime</drawerType>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<repairEffect>Repair</repairEffect>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<filthLeaving>Filth_RubbleRock</filthLeaving>
		<minifiedDef>MinifiedThing</minifiedDef>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<passability>Standable</passability>
		<comps>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li Class="CompProperties_Art">
				<nameMaker>NamerArtSculpture</nameMaker>
				<descriptionMaker>ArtDescription_Furniture</descriptionMaker>
				<minQualityForArtistic>Excellent</minQualityForArtistic>
			</li>
		</comps>
		<inspectorTabs>
			<li>ITab_Art</li>
		</inspectorTabs>
		<tradeTags>
			<li>Furniture</li>
		</tradeTags>
		<researchPrerequisites>
			<li>RH_TET_Dwarfs_Furniture_Advanced</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="RH_TET_Dwarfs_RugBase">
		<defName>RH_TET_Dwarfs_Rug2xTwo</defName>
		<label>dawi rug (2x2)</label>
		<description>A small rug, made of stoneweave. Good for a bedroom, or kitchen perhaps. Will help keep the area clean. Created by the skilled hands of a dwarf.</description>
		<graphicData>
			<texPath>Things/Building/Furniture/Floor/DawiSlabMedium</texPath>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToMake>3600</WorkToMake>
			<Beauty>30</Beauty>
			<Mass>5</Mass>
		</statBases>
		<stuffCategories>
			<li>RH_TET_Dwarfs_StoneFabric</li>
		</stuffCategories>
		<costStuffCount>60</costStuffCount>
		<size>(2,2)</size>
	</ThingDef>

	<ThingDef ParentName="RH_TET_Dwarfs_RugBase">
		<defName>RH_TET_Dwarfs_Rug3xThree</defName>
		<label>dawi rug (3x3)</label>
		<description>A large rug, made of stoneweave. Good for a bedroom, or kitchen perhaps. Will help keep the area clean. Created by the skilled hands of a dwarf.</description>
		<graphicData>
			<texPath>Things/Building/Furniture/Floor/DawiSlabBroad</texPath>
			<drawSize>(3,3)</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<WorkToMake>4800</WorkToMake>
			<Beauty>45</Beauty>
			<Mass>8</Mass>
		</statBases>
		<stuffCategories>
			<li>RH_TET_Dwarfs_StoneFabric</li>
		</stuffCategories>
		<costStuffCount>90</costStuffCount>
		<size>(3,3)</size>
	</ThingDef>

	<!-- Glowing Floor Tiles -->
    <DesignatorDropdownGroupDef>
        <defName>RH_TET_Dwarfs_FloorLights</defName> 
    </DesignatorDropdownGroupDef>
    
    <ThingDef Name="RH_TET_Dwarfs_FloorTile_Base" ParentName="BuildingBase" Abstract="True">
        <description>Warpstone infused floor tiles that glow. Multiple tiles can occupy the same space, allowing for interestig designs.</description>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <altitudeLayer>Floor</altitudeLayer>
        <coversFloor>false</coversFloor>
        <passability>Standable</passability>
        <useHitPoints>true</useHitPoints>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToBuild>250</WorkToBuild>
            <Beauty>3</Beauty>
            <Flammability>0</Flammability>
        </statBases>
        <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
        <designationCategory>Floors</designationCategory>
        <selectable>true</selectable>
        <building>
            <isEdifice>false</isEdifice>
            <isInert>true</isInert>
        </building>
        <designatorDropdown>RH_TET_Dwarfs_FloorLights</designatorDropdown>
        <comps>
            <li Class="CompProperties_Glower">
                <glowRadius>3</glowRadius>
                <glowColor>(220,250,200,0)</glowColor>
                <darklightToggle>true</darklightToggle>
            </li>
        </comps>
        <researchPrerequisites>
            <li>RH_TET_Dwarfs_Runic_Advanced</li>
        </researchPrerequisites>
    </ThingDef>
    
