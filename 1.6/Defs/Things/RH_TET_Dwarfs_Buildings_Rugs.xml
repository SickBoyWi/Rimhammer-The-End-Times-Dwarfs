		<graphicData>
			<texPath>Things/Building/Furniture/Floor/DawiSlabMedium</texPath>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToMake>3600</WorkToMake>
			<Beauty>30</Beauty>
			<Mass>5</Mass>
		</statBases>
		<stuffCategories>
			<li>RH_TET_Dwarfs_StoneFabric</li>
		</stuffCategories>
		<costStuffCount>60</costStuffCount>
		<size>(2,2)</size>
	</ThingDef>

	<ThingDef ParentName="RH_TET_Dwarfs_RugBase">
